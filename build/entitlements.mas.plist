<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Mac App Store build: sandboxed main app -->
  <key>com.apple.security.app-sandbox</key><true/>
  <!-- Electron helper processes talk through this application group -->
  <key>com.apple.security.application-groups</key>
  <array><string>C68LA5KQ8J.com.pickywawa.cyberdog</string></array>
  <!-- SSH, SFTP, FTP, WebDAV, S3, Azure and cloud drive connections -->
  <key>com.apple.security.network.client</key><true/>
  <!-- Files and folders chosen by the user (uploads, downloads, keys, imports, exports) -->
  <key>com.apple.security.files.user-selected.read-write</key><true/>
  <key>com.apple.security.files.downloads.read-write</key><true/>
  <!-- Synchronized folders: a chosen folder stays readable after a restart (security-scoped bookmarks) -->
  <key>com.apple.security.files.bookmarks.app-scope</key><true/>
</dict>
</plist>
